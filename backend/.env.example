# ==============================================================================
# PrivyShield AI - Backend Environment Configuration Template
# DO NOT store real API keys, passwords, or secrets in this file.
# Copy this file to backend/.env and populate with your production credentials.
# On Render: Add these as Environment Variables in the Render Dashboard.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars

# Supabase Credentials (from Supabase Dashboard -> Settings -> API)
# Kept securely on backend only - never expose to frontend
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_DB_PASSWORD=your_supabase_database_password_here

# AI Provider Credentials (Backend only)
# Google Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# xAI Grok API key: https://console.x.ai/
GROK_API_KEY=your_grok_api_key_here

# Frontend Application URL (Allowed origin for CORS in production)
# Set to your Vercel deployment URL (e.g. https://privyshield.vercel.app)
FRONTEND_URL=https://your-privyshield-app.vercel.app
