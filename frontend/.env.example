# ==============================================================================
# PrivyShield AI - Frontend Environment Configuration Template
# DO NOT store secrets, API keys, or database credentials here.
# Copy this file to frontend/.env for local development.
# On Vercel: Add VITE_API_BASE_URL as an Environment Variable in the Project Settings.
# ==============================================================================

# Backend API Base URL
# For Local Development:
# VITE_API_BASE_URL=http://localhost:5000/api
#
# For Production Deployment on Vercel:
# Set to your deployed Render backend service URL:
VITE_API_BASE_URL=https://your-privyshield-backend.onrender.com/api
